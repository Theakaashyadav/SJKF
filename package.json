{
  "name": "swabhiman-foundation-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/verify-static-export.mjs",
    "start": "node scripts/static-preview.mjs",
    "preview": "node scripts/static-preview.mjs",
    "typecheck": "tsc --noEmit",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:language": "node scripts/language-audit.mjs",
    "audit:payment": "node scripts/payment-audit.mjs",
    "test:payments": "node --experimental-strip-types --experimental-test-isolation=none --test tests/payment-api-url.test.ts tests/payment-client.test.ts tests/payment-pending.test.ts && node --experimental-test-isolation=none --test google-apps-script/tests/payment.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "lucide-react": "latest",
    "next": "16.4.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright-core": "^1.63.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}

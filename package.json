  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright-core": "^1.63.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }

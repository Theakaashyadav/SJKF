# Private Razorpay API credentials. Keep real values in this service's .env only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated exact website origins. Production origins must use HTTPS.
# Add the actual Render Static Site origin and custom domain before deployment.
PAYMENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=4000

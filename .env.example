# Server-only Razorpay Standard Checkout credentials. Use the matching Test Mode
# key pair first, then replace both with Live Mode credentials when ready.
# Paste real values in .env.local, never in this tracked example or GitHub.
# Restart the dev server after editing .env.local.
# Hosted Render deployment: new Node Web Service > Environment; save and redeploy.
# Do not prefix either variable with NEXT_PUBLIC_. No Payment Button ID is needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

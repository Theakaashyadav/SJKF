# Public website origin, without a trailing slash. On Render, an empty value
# uses RENDER_EXTERNAL_URL during the static build.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=swabhimanfoundation2026@gmail.com
NEXT_PUBLIC_CONTACT_PHONE="+91 9528547505"
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Public Google Apps Script WEB APP deployment URL ending in /exec.
# Example: https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Deploy google-apps-script/Code.gs as Execute as Me, Who has access Anyone.
# Use the same URL in the Static Site's Environment, then rebuild/redeploy.
# Keep RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET and SPREADSHEET_ID in Apps Script
# Project Settings > Script Properties. Do not put secrets in this file,
# any NEXT_PUBLIC_ variable, JavaScript, or the Static Site build environment.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyMpvILMYxYnw1dz0UxqBg4Jb9TTO6X85a4JghIkwfNdvrWXkl60Upuv0k4oaslW16o/exec

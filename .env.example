# Public website origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://example.org
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Razorpay credentials (server-side secret must never use NEXT_PUBLIC_)
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
PAYMENT_RECEIPT_SECRET=replace_with_a_long_random_value
DONATION_PAN_ENABLED=false
NEXT_PUBLIC_DONATION_PAN_ENABLED=false

# Durable payment ledger / webhook idempotency (Vercel KV or Upstash Redis REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
PAYMENT_RECORD_TTL_SECONDS=31536000

# Email delivery (Resend). Verify the sender domain before production use.
RESEND_API_KEY=re_replace_me
RECEIPT_FROM_EMAIL=Swabhiman Foundation <receipts@example.org>

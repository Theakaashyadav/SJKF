NEXT_PUBLIC_CONTACT_PHONE="+91 9528547505"
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Public origin of the SEPARATE payment API, without /api/payments or a trailing
# slash. Local example: http://127.0.0.1:4000. Production must use HTTPS.
# Put the deployed API service's actual URL here and in the Static Site's
# Environment settings, then rebuild/redeploy the static website.
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET and PAYMENT_ALLOWED_ORIGINS belong only
# in payment-api/.env or the payment API Web Service's private Environment.
# Never put the Key Secret in a NEXT_PUBLIC_ variable or the Static Site build.
NEXT_PUBLIC_RAZORPAY_API_URL=
